# คัดลอกเป็น .env แล้วแก้ค่า

# ---- Docker Compose ----
# รหัสผ่าน Postgres (ตั้งให้เดายากหน่อย)
POSTGRES_PASSWORD=tube2media
# พอร์ตที่เปิดบนเครื่องโฮสต์
APP_PORT=8080
TZ=Asia/Bangkok
# ไฟล์ที่แปลงเสร็จจะถูกลบเองถ้าไม่มีคนกดดาวน์โหลดภายใน N นาที
FILE_TTL_MIN=15

# ---- รันตรงบนเครื่อง (ไม่ใช้ Docker) ----
# DB_DRIVER=pglite            # ใช้ Postgres แบบ embedded ไม่ต้องติดตั้งอะไร
# PGLITE_DIR=./.pglite
# DB_DRIVER=pg
# DATABASE_URL=postgres://tube2media:tube2media@localhost:5432/tube2media
# PORT=8080
# TMP_DIR=./tmp                # ที่พักไฟล์ชั่วคราว (ลบทิ้งอัตโนมัติ)
# FILE_TTL_MIN=15
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=
